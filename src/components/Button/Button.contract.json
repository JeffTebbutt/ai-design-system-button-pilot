{
  "name": "Button",
  "variant": "primary",
  "description": "Primary action button",

  "props": {
    "label": {
      "type": "string",
      "required": true
    },
    "onClick": {
      "type": "function",
      "required": false
    },
    "disabled": {
      "type": "boolean",
      "default": false
    },
    "isLoading": {
      "type": "boolean",
      "default": false
    },
    "type": {
      "type": "enum",
      "values": ["button", "submit", "reset"],
      "default": "button"
    }
  },

"states": ["default", "hover", "pressed", "focus", "disabled", "loading"],

  "tokens": {
  "background": {
    "allowed": ["color.surface.primary"]
  },
  "backgroundHover": {
    "allowed": ["color.surface.primary-weak"]
  },

  "backgroundPressed": {
  "allowed": ["color.surface.primary-strong"]
},

  "backgroundDisabled": {
  "allowed": ["color.surface.disabled"]
},
"textDisabled": {
  "allowed": ["color.on-surface.disabled"]
},

  "text": {
    "allowed": ["color.on-surface.primary"]
  },
  "shadow": {
    "allowed": ["box-shadow.elevation.1"]
  },

  "focusOffset": {
  "allowed": ["space.focus.offset"]
},
"focusRingSize": {
  "allowed": ["size.focus.ring"]
},
"focusRingColor": {
  "allowed": ["color.focus.ring"]
},
"focusInnerColor": {
  "allowed": ["color.focus.inner"]
},

  "height": {
    "allowed": ["size.7xl"]
  },
  "minWidth": {
    "allowed": ["size.11xl"]
  },
  "paddingX": {
    "allowed": ["space.large"]
  },
  "paddingY": {
    "allowed": ["space.none"]
  },
  "radius": {
    "allowed": ["shape.corner.full"]
  },
  "gap": {
    "allowed": ["space.none"]
  },
  "typography": {
    "allowed": ["typography.label.large"]
  }
},

  "layout": {
    "display": "inline-flex",
    "alignItems": "center",
    "justifyContent": "center"
  },

  "constraints": {
    "noHardcodedValues": true,
    "tokensRequired": true
  }
}